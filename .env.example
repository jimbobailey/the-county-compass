# Configure these in Netlify under Site configuration > Environment variables.
# Do not put real values in this file.
ADMIN_PASSWORD=choose-a-new-strong-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret
NOTIFY_EMAIL=your-notification-address@example.com
EMAIL_USER=your-sending-address@example.com
EMAIL_PASS=your-google-app-password
